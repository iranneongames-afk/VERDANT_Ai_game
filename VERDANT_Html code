<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>VERDANT — A Growing Journey</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:100%;height:100%;overflow:hidden;background:#0d1a0d;}
  body{
    font-family:'Trebuchet MS','Segoe UI',system-ui,sans-serif;
    color:#2b1d0e;user-select:none;-webkit-tap-highlight-color:transparent;
  }
  #cv{display:block;position:absolute;inset:0;cursor:none;}

  #hud{
    position:absolute;inset:0;pointer-events:none;padding:18px 24px;
    display:flex;justify-content:space-between;align-items:flex-start;
    opacity:0;transition:opacity .35s ease;z-index:10;
  }
  #hud.on{opacity:1;}
  .col{display:flex;flex-direction:column;gap:2px;}
  .col.center{align-items:center;}
  .col.right{align-items:flex-end;}
  .lvl-num{font-size:11px;letter-spacing:5px;color:#9c8466;font-weight:600;}
  .lvl-name{font-size:17px;letter-spacing:4px;color:#2b1d0e;font-weight:700;}
  .len-wrap{display:flex;align-items:baseline;gap:6px;font-size:24px;
    color:#2b1d0e;font-weight:700;letter-spacing:1px;}
  .len-wrap .pct{font-size:14px;color:#9c8466;}
  .len-label{font-size:10px;letter-spacing:5px;color:#9c8466;font-weight:600;}
  .timer{font-size:24px;letter-spacing:2px;color:#b8722e;font-weight:700;}
  .best{font-size:10px;letter-spacing:3px;color:#9c8466;font-weight:600;}

  #lenBar{
    position:absolute;left:50%;bottom:28px;transform:translateX(-50%);
    width:min(340px,60vw);height:6px;border-radius:6px;
    background:rgba(43,29,14,.15);overflow:hidden;z-index:10;
    opacity:0;transition:opacity .35s ease;
  }
  #lenBar.on{opacity:1;}
  #lenFill{height:100%;width:100%;border-radius:6px;
    background:linear-gradient(90deg,#7cb342,#4fc3f7);
    transition:width .08s linear, background .3s ease;}

  #hint{
    position:absolute;left:50%;bottom:56px;transform:translateX(-50%);
    font-size:11px;letter-spacing:4px;color:#6b5a3e;font-weight:600;
    padding:9px 20px;border-radius:30px;
    background:rgba(244,236,216,.85);border:1px solid rgba(43,29,14,.12);
    backdrop-filter:blur(4px);opacity:0;transition:opacity .5s ease;
    pointer-events:none;z-index:10;white-space:nowrap;
  }
  #hint.on{opacity:1;}

  .screen{
    position:absolute;inset:0;display:none;align-items:center;justify-content:center;
    background:radial-gradient(circle at 50% 42%,rgba(244,236,216,.75),rgba(30,20,10,.88));
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    z-index:20;padding:20px;
  }
  .screen.on{display:flex;animation:scrIn .28s ease both;}
  @keyframes scrIn{from{opacity:0}to{opacity:1}}

  .panel{
    text-align:center;padding:38px 44px;border-radius:22px;
    background:linear-gradient(165deg,#fdf7e6,#f0e6c8);
    box-shadow:0 20px 60px rgba(30,20,10,.45), inset 0 0 0 1px rgba(43,29,14,.08);
    max-width:640px;width:100%;
    animation:panIn .35s cubic-bezier(.2,.9,.3,1.3) both;
  }
  @keyframes panIn{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}

  .logo{
    font-size:clamp(44px,10vw,72px);letter-spacing:.14em;font-weight:800;
    color:#2d5016;line-height:1;
    text-shadow:2px 2px 0 rgba(124,179,66,.35), 0 6px 24px rgba(45,80,22,.25);
    margin-bottom:6px;
  }
  .tagline{font-size:12px;letter-spacing:9px;color:#8b6f4a;font-weight:600;margin-bottom:26px;}

  h2{font-size:20px;letter-spacing:7px;color:#2d5016;margin-bottom:8px;font-weight:700;}
  h2.wilt{color:#8b2c2c;}
  h2.bloom{color:#c98a1f;}

  .desc{font-size:13px;line-height:1.9;color:#6b5a3e;letter-spacing:.5px;margin-bottom:26px;}
  .desc b{color:#2d5016;font-weight:700;}

  .btn{
    pointer-events:auto;cursor:pointer;display:block;width:100%;margin:9px 0;
    padding:13px 24px;font:inherit;font-size:13px;letter-spacing:4px;
    text-transform:uppercase;font-weight:700;
    color:#2d5016;background:rgba(124,179,66,.12);
    border:1.5px solid rgba(45,80,22,.35);border-radius:12px;
    transition:all .16s ease;
  }
  .btn:hover{background:rgba(124,179,66,.28);border-color:#2d5016;
    transform:translateY(-2px);box-shadow:0 6px 18px rgba(45,80,22,.2);}
  .btn:active{transform:translateY(0) scale(.99);}
  .btn.primary{
    background:linear-gradient(135deg,#7cb342,#4e8c1e);
    color:#fdf7e6;border-color:#2d5016;
    box-shadow:0 8px 22px rgba(45,80,22,.35);
  }
  .btn.primary:hover{box-shadow:0 10px 30px rgba(45,80,22,.5);}
  .btn.ghost{border-color:rgba(45,80,22,.18);color:#8b6f4a;background:transparent;}
  .btn.ghost:hover{background:rgba(45,80,22,.06);color:#2d5016;box-shadow:none;transform:none;}

  .howto{
    margin-top:24px;padding-top:20px;border-top:1px dashed rgba(45,80,22,.2);
    font-size:11px;letter-spacing:2px;line-height:2.1;color:#8b6f4a;text-align:left;
  }
  .howto .k{display:inline-block;padding:1px 8px;margin:0 4px;border-radius:5px;
    border:1px solid rgba(45,80,22,.3);color:#2d5016;font-size:10px;font-weight:700;}

  .level-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0 18px;}
  .lv{
    pointer-events:auto;cursor:pointer;padding:14px 8px 12px;border-radius:14px;
    border:1.5px solid rgba(45,80,22,.22);background:rgba(124,179,66,.06);
    transition:all .16s ease;position:relative;
  }
  .lv:hover:not(.locked){background:rgba(124,179,66,.2);transform:translateY(-3px);
    box-shadow:0 8px 20px rgba(45,80,22,.2);border-color:#2d5016;}
  .lv .n{font-size:20px;letter-spacing:2px;color:#2d5016;font-weight:700;}
  .lv .s{font-size:13px;letter-spacing:2px;color:#c98a1f;margin-top:5px;height:14px;}
  .lv .t{font-size:9px;letter-spacing:1px;color:#9c8466;margin-top:4px;font-weight:600;}
  .lv.locked{opacity:.35;cursor:not-allowed;}
  .lv.locked .n{color:#9c8466;}

  .stars{font-size:42px;letter-spacing:10px;color:#c98a1f;margin:14px 0 6px;
    text-shadow:0 4px 14px rgba(201,138,31,.4);}
  .time-big{font-size:38px;letter-spacing:3px;color:#2d5016;font-weight:700;margin:6px 0;}
  .sub-line{font-size:11px;letter-spacing:4px;color:#9c8466;margin-bottom:22px;font-weight:600;}
  .new-best{font-size:11px;letter-spacing:5px;color:#4e8c1e;font-weight:700;margin-bottom:14px;height:14px;}

  @media(max-width:560px){
    .panel{padding:26px 22px;border-radius:16px;}
    .level-grid{gap:8px;}
    .lv{padding:10px 4px;}
    .lv .n{font-size:16px;}
    #hud{padding:12px 14px;}
    .timer,.len-wrap{font-size:18px;}
    .lvl-name{font-size:13px;letter-spacing:3px;}
    #hint{font-size:9px;letter-spacing:2px;bottom:48px;}
  }
</style>
</head>
<body>

<canvas id="cv"></canvas>

<div id="hud">
  <div class="col">
    <div class="lvl-num" id="hudLvlNum">SECTOR 01</div>
    <div class="lvl-name" id="hudLvlName">FIRST SPROUT</div>
  </div>
  <div class="col center">
    <div class="len-wrap"><span id="hudLen">100</span><span class="pct">%</span></div>
    <div class="len-label">VITALITY</div>
  </div>
  <div class="col right">
    <div class="timer" id="hudTimer">0.00</div>
    <div class="best" id="hudBest">BEST --:--</div>
  </div>
</div>

<div id="lenBar"><div id="lenFill"></div></div>
<div id="hint">MOVE THE MOUSE — the vine follows the light</div>

<!-- ============ MENU ============ -->
<div class="screen on" id="scr-menu">
  <div class="panel">
    <div class="logo">VERDANT</div>
    <div class="tagline">A GROWING JOURNEY</div>
    <p class="desc">
      You are a living vine, drawn toward the light of your cursor.<br>
      Your <b>vitality</b> drains with every breath — drink <b>dew</b> to survive.<br>
      Avoid the <b>thorns</b>. Reach the <b>golden blossom</b>.
    </p>
    <button class="btn primary" id="btnPlay">▶ &nbsp;BEGIN</button>
    <button class="btn" id="btnLevels">LEVEL SELECT</button>
    <div class="howto">
      <div><span class="k">MOUSE</span> / <span class="k">TOUCH</span> &nbsp;— guide the vine</div>
      <div><span class="k">P</span> / <span class="k">ESC</span> — pause &nbsp;&nbsp; <span class="k">R</span> — restart</div>
      <div style="color:#a89070;margin-top:6px;">The vine has momentum. Plan your turns.</div>
    </div>
  </div>
</div>

<!-- ============ LEVEL SELECT ============ -->
<div class="screen" id="scr-levels">
  <div class="panel">
    <h2>CHOOSE A GARDEN</h2>
    <div class="sub-line" style="margin-top:10px;">WHERE SHALL THE VINE GROW?</div>
    <div class="level-grid" id="levelGrid"></div>
    <button class="btn ghost" id="btnBackMenu">← BACK</button>
  </div>
</div>

<!-- ============ PAUSE ============ -->
<div class="screen" id="scr-pause">
  <div class="panel" style="max-width:360px;">
    <h2>RESTING</h2>
    <div class="sub-line" style="margin-top:12px;">THE VINE PAUSES</div>
    <button class="btn primary" id="btnResume">RESUME</button>
    <button class="btn" id="btnRestartP">RESTART</button>
    <button class="btn ghost" id="btnMenuP">MAIN MENU</button>
  </div>
</div>

<!-- ============ DEATH ============ -->
<div class="screen" id="scr-dead">
  <div class="panel" style="max-width:360px;">
    <h2 class="wilt">WILTED</h2>
    <div class="sub-line" style="margin-top:12px;">THE VINE RAN DRY</div>
    <button class="btn primary" id="btnRetry">TRY AGAIN</button>
    <button class="btn ghost" id="btnMenuD">MAIN MENU</button>
  </div>
</div>

<!-- ============ WIN ============ -->
<div class="screen" id="scr-win">
  <div class="panel" style="max-width:400px;">
    <h2 class="bloom">IT BLOOMED</h2>
    <div class="stars" id="winStars">★★★</div>
    <div class="new-best" id="winNewBest"></div>
    <div class="time-big" id="winTime">0.00</div>
    <div class="sub-line" id="winBest">BEST 0.00</div>
    <button class="btn primary" id="btnNext">NEXT GARDEN →</button>
    <button class="btn" id="btnReplay">REPLAY</button>
    <button class="btn ghost" id="btnMenuW">MAIN MENU</button>
  </div>
</div>

<!-- ============ COMPLETE ============ -->
<div class="screen" id="scr-complete">
  <div class="panel" style="max-width:440px;">
    <h2 class="bloom">EVERY GARDEN IN BLOOM</h2>
    <div class="stars">✦ ✦ ✦</div>
    <p class="desc" style="margin-top:14px;">
      The vine has grown through every garden.<br>It has earned its rest.
    </p>
    <div class="sub-line" id="compTotal">TOTAL TIME 0.00</div>
    <button class="btn primary" id="btnCompMenu">MAIN MENU</button>
  </div>
</div>

<script>
(() => {
'use strict';

/* =========================================================
   CONSTANTS
   ========================================================= */
const W = 1600, H = 900;

const SEG_SPACING   = 5;      // px between vine segments
const MAX_SEGMENTS  = 220;    // 1100 px max visual length
const HEAD_SPEED    = 275;    // px/s
const MAX_TURN      = 5.2;    // rad/s — momentum constraint
const MAX_LENGTH    = 1000;   // vitality in px units (0..1000)
const DRAIN_RATE    = 48;     // px/s
const DROPLET_VALUE = 300;
const THORN_DAMAGE  = 380;

/* =========================================================
   CANVAS
   ========================================================= */
const cv  = document.getElementById('cv');
const ctx = cv.getContext('2d');
const view = { scale: 1, ox: 0, oy: 0 };

function resize(){
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = window.innerWidth, h = window.innerHeight;
  cv.width  = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  cv.style.width  = w + 'px';
  cv.style.height = h + 'px';
  view.scale = Math.min(w / W, h / H) * dpr;
  view.ox = (cv.width  - W * view.scale) / 2;
  view.oy = (cv.height - H * view.scale) / 2;
}
window.addEventListener('resize', resize);

/* =========================================================
   LEVELS — each garden
   ========================================================= */
const LEVELS = [
  {
    name: 'FIRST SPROUT', par: 15,
    start:  { x: 200, y: 450 },
    flower: { x: 1400, y: 450 },
    droplets: [ {x:500,y:450},{x:800,y:450},{x:1100,y:450} ],
    thorns: [],
    wind: {x:0, y:0}
  },
  {
    name: 'THIRSTY', par: 20,
    start:  { x: 200, y: 720 },
    flower: { x: 1420, y: 180 },
    droplets: [
      {x:430,y:600},{x:650,y:460},{x:880,y:330},{x:1120,y:230},{x:1320,y:180}
    ],
    thorns: [],
    wind: {x:0, y:0}
  },
  {
    name: 'THORNFIELD', par: 22,
    start:  { x: 180, y: 450 },
    flower: { x: 1430, y: 450 },
    droplets: [
      {x:400,y:450},{x:680,y:250},{x:680,y:650},{x:1000,y:450},{x:1250,y:450}
    ],
    thorns: [
      {x:580,y:450,r:62},{x:900,y:450,r:62}
    ],
    wind: {x:0, y:0}
  },
  {
    name: 'CROSSWIND', par: 24,
    start:  { x: 180, y: 450 },
    flower: { x: 1420, y: 450 },
    droplets: [
      {x:480,y:380},{x:780,y:360},{x:1080,y:380},{x:1320,y:440}
    ],
    thorns: [ {x:660,y:560,r:58},{x:960,y:330,r:58} ],
    wind: {x:0, y:90}
  },
  {
    name: 'THE LONG WAY', par: 28,
    start:  { x: 150, y: 760 },
    flower: { x: 1450, y: 140 },
    droplets: [
      {x:400,y:760},{x:620,y:560},{x:480,y:360},
      {x:880,y:300},{x:1120,y:440},{x:1320,y:260}
    ],
    thorns: [
      {x:750,y:760,r:70},{x:230,y:450,r:58},
      {x:950,y:620,r:60},{x:1220,y:660,r:60}
    ],
    wind: {x:25, y:0}
  },
  {
    name: 'BLOOM', par: 32,
    start:  { x: 150, y: 450 },
    flower: { x: 1460, y: 450 },
    droplets: [
      {x:340,y:280},{x:340,y:620},{x:700,y:180},{x:700,y:720},
      {x:1030,y:300},{x:1030,y:600},{x:1300,y:450}
    ],
    thorns: [
      {x:540,y:450,r:62},{x:870,y:450,r:62},{x:1170,y:450,r:52},{x:200,y:450,r:42}
    ],
    wind: {x:0, y:0}
  }
];

/* =========================================================
   SAVE
   ========================================================= */
const SAVE_KEY = 'verdant_save_v1';
let save = { best: {}, unlocked: 1 };

function loadSave(){
  try{
    const raw = localStorage.getItem(SAVE_KEY);
    if (raw){
      const s = JSON.parse(raw);
      if (s && typeof s === 'object'){
        save.best = s.best || {};
        save.unlocked = Math.max(1, Math.min(LEVELS.length, s.unlocked || 1));
      }
    }
  }catch(e){}
}
function persist(){
  try{ localStorage.setItem(SAVE_KEY, JSON.stringify(save)); }catch(e){}
}

function starsFor(time, par){
  if (time <= par)       return 3;
  if (time <= par * 1.7) return 2;
  return 1;
}
function fmt(t){
  if (t === undefined || t === null) return '--:--';
  const m = Math.floor(t / 60);
  const s = t - m * 60;
  return (m > 0 ? m + ':' + (s < 10 ? '0' : '') : '') + s.toFixed(2);
}

/* =========================================================
   STATE
   ========================================================= */
let state = 'menu';
let levelIndex = 0;
let level = null;
let vine = null;
let mouse = { x: W / 2, y: H / 2 };
let elapsed = 0;
let tGlobal = 0;
let shake = 0;
let hintTimer = 0;

const parts = [];
const grass = [];
for (let i = 0; i < 220; i++){
  grass.push({
    x: Math.random() * W,
    y: Math.random() * H,
    r: Math.random() * 1.6 + 0.4,
    a: Math.random() * 0.35 + 0.08,
    ph: Math.random() * Math.PI * 2,
    hue: 60 + Math.random() * 40
  });
}

/* =========================================================
   DOM
   ========================================================= */
const $ = id => document.getElementById(id);
const hud = $('hud');
const hintEl = $('hint');
const lenBar = $('lenBar');
const lenFill = $('lenFill');

const SCREENS = {
  menu: $('scr-menu'),
  levels: $('scr-levels'),
  pause: $('scr-pause'),
  dead: $('scr-dead'),
  win: $('scr-win'),
  complete: $('scr-complete')
};

function showScreen(name){
  for (const k in SCREENS) SCREENS[k].classList.toggle('on', k === name);
  const inPlay = (name === null);
  hud.classList.toggle('on', inPlay);
  lenBar.classList.toggle('on', inPlay);
  if (!inPlay) hintEl.classList.remove('on');
}

/* =========================================================
   AUDIO — soft organic chimes
   ========================================================= */
let actx = null;
function audio(){
  if (!actx){
    try{ actx = new (window.AudioContext || window.webkitAudioContext)(); }catch(e){ actx = false; }
  }
  if (actx && actx.state === 'suspended') actx.resume();
  return actx;
}
function tone(freq, dur, type, vol, glide){
  const a = audio();
  if (!a) return;
  try{
    const o = a.createOscillator();
    const g = a.createGain();
    o.type = type || 'sine';
    o.frequency.setValueAtTime(freq, a.currentTime);
    if (glide) o.frequency.exponentialRampToValueAtTime(glide, a.currentTime + dur);
    g.gain.setValueAtTime(0.0001, a.currentTime);
    g.gain.exponentialRampToValueAtTime(vol || 0.05, a.currentTime + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + dur);
    o.connect(g); g.connect(a.destination);
    o.start(); o.stop(a.currentTime + dur + 0.03);
  }catch(e){}
}

/* =========================================================
   PARTICLES
   ========================================================= */
function spawnBurst(x, y, n, colors, spd, size){
  spd = spd || 200;
  size = size || 3;
  for (let i = 0; i < n; i++){
    const a = Math.random() * Math.PI * 2;
    const s = spd * (0.2 + Math.random() * 0.95);
    parts.push({
      x, y,
      vx: Math.cos(a) * s,
      vy: Math.sin(a) * s - 40,
      life: 0.5 + Math.random() * 0.7,
      max: 1.2,
      color: colors[(Math.random() * colors.length) | 0],
      size: size * (0.5 + Math.random() * 0.9),
      spin: (Math.random() - 0.5) * 6,
      rot: Math.random() * Math.PI * 2,
      grav: 260
    });
  }
}
function updateParticles(dt){
  for (let i = parts.length - 1; i >= 0; i--){
    const q = parts[i];
    q.vy += q.grav * dt;
    q.x += q.vx * dt;
    q.y += q.vy * dt;
    q.rot += q.spin * dt;
    const d = Math.pow(0.2, dt);
    q.vx *= d; q.vy *= d;
    q.life -= dt;
    if (q.life <= 0) parts.splice(i, 1);
  }
}

/* =========================================================
   ANGLE HELPERS
   ========================================================= */
function angleDiff(from, to){
  let d = to - from;
  while (d >  Math.PI) d -= Math.PI * 2;
  while (d < -Math.PI) d += Math.PI * 2;
  return d;
}

/* =========================================================
   LEVEL LIFECYCLE
   ========================================================= */
function startLevel(i){
  levelIndex = i;
  const L = LEVELS[i];

  level = {
    name: L.name,
    par: L.par,
    start: { x: L.start.x, y: L.start.y },
    flower: { x: L.flower.x, y: L.flower.y, bloom: 0 },
    droplets: L.droplets.map(d => ({ x: d.x, y: d.y, r: 11, got: false, phase: Math.random() * Math.PI * 2 })),
    thorns: L.thorns.map(t => ({ x: t.x, y: t.y, r: t.r })),
    wind: { x: L.wind.x, y: L.wind.y }
  };

  // vine chain
  const segs = [];
  for (let k = 0; k < MAX_SEGMENTS; k++){
    segs.push({ x: L.start.x, y: L.start.y });
  }

  vine = {
    segments: segs,
    head: { x: L.start.x, y: L.start.y, angle: 0 },
    length: MAX_LENGTH * 0.85,
    alive: true,
    dieT: 0,
    leafSeed: 0
  };

  mouse.x = L.start.x + 200;
  mouse.y = L.start.y;

  elapsed = 0;
  shake = 0;
  parts.length = 0;

  state = 'play';
  showScreen(null);
  syncHUD();
  showHint('MOVE THE MOUSE — the vine follows the light', 3.6);
}

function syncHUD(){
  if (!level) return;
  $('hudLvlNum').textContent  = 'SECTOR ' + String(levelIndex + 1).padStart(2, '0');
  $('hudLvlName').textContent = level.name;
  const b = save.best['L' + levelIndex];
  $('hudBest').textContent = 'BEST ' + (b ? fmt(b.time) : '--:--');
}

function showHint(text, seconds){
  hintEl.textContent = text;
  hintEl.classList.add('on');
  hintTimer = seconds;
}

/* =========================================================
   INPUT
   ========================================================= */
function setPointer(x, y){
  mouse.x = Math.max(0, Math.min(W, x));
  mouse.y = Math.max(0, Math.min(H, y));
}
function clientToWorld(cx, cy){
  return {
    x: (cx * (cv.width / (window.devicePixelRatio || 1) * 1) - view.ox) / view.scale,
    y: (cy * (cv.height / (window.devicePixelRatio || 1) * 1) - view.oy) / view.scale
  };
}
// simpler: derive from canvas bounding rect
function pointerPos(e){
  const r = cv.getBoundingClientRect();
  const cx = (e.clientX - r.left);
  const cy = (e.clientY - r.top);
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  return {
    x: (cx * dpr - view.ox) / view.scale,
    y: (cy * dpr - view.oy) / view.scale
  };
}

cv.addEventListener('mousemove', e => {
  const p = pointerPos(e);
  setPointer(p.x, p.y);
});
cv.addEventListener('touchmove', e => {
  e.preventDefault();
  const t = e.touches[0];
  const p = pointerPos(t);
  setPointer(p.x, p.y);
}, { passive: false });
cv.addEventListener('touchstart', e => {
  const t = e.touches[0];
  const p = pointerPos(t);
  setPointer(p.x, p.y);
}, { passive: true });
cv.addEventListener('contextmenu', e => e.preventDefault());

window.addEventListener('keydown', e => {
  if (e.code === 'Space'){
    e.preventDefault();
    if (state === 'menu') startLevel(0);
    else if (state === 'dead') startLevel(levelIndex);
    else if (state === 'win') nextLevel();
    return;
  }
  if (e.code === 'Escape' || e.code === 'KeyP'){
    e.preventDefault();
    if (state === 'play') pause();
    else if (state === 'pause') resume();
    return;
  }
  if (e.code === 'KeyR'){
    if (state === 'play' || state === 'pause' || state === 'dead') startLevel(levelIndex);
  }
});

/* =========================================================
   PAUSE / DEATH / WIN
   ========================================================= */
function pause(){
  if (state !== 'play') return;
  state = 'pause';
  showScreen('pause');
}
function resume(){
  if (state !== 'pause') return;
  state = 'play';
  showScreen(null);
}

function die(){
  if (state !== 'play') return;
  state = 'dead';
  vine.alive = false;
  vine.dieT = 0;
  shake = 14;
  spawnBurst(vine.head.x, vine.head.y, 30, ['#8bc34a','#7cb342','#a1887f'], 220, 3);
  tone(220, 0.5, 'sine', 0.06, 110);
  hintEl.classList.remove('on');
  setTimeout(() => { if (state === 'dead') showScreen('dead'); }, 700);
}

function winLevel(){
  if (state !== 'play') return;
  state = 'win';
  level.flower.bloom = 0.01;
  shake = 8;
  spawnBurst(level.flower.x, level.flower.y, 55, ['#ffd166','#ffb300','#fff3c4','#7cb342'], 320, 4);
  tone(880, 0.2, 'sine', 0.06);
  setTimeout(() => tone(1320, 0.3, 'sine', 0.05), 120);
  setTimeout(() => tone(1760, 0.4, 'sine', 0.04), 260);

  const t = elapsed;
  const st = starsFor(t, level.par);
  const key = 'L' + levelIndex;
  const prev = save.best[key];
  let isNew = false;

  if (!prev || t < prev.time){
    save.best[key] = { time: t, stars: Math.max(st, prev ? prev.stars : 0) };
    isNew = true;
  } else if (st > (prev.stars || 0)){
    prev.stars = st;
  }
  if (levelIndex + 1 >= save.unlocked && levelIndex + 1 < LEVELS.length){
    save.unlocked = levelIndex + 2;
  }
  persist();

  const b = save.best[key];
  $('winStars').textContent = '★★★☆☆☆'.slice(3 - st, 6 - st);
  $('winTime').textContent  = fmt(t);
  $('winBest').textContent  = 'BEST ' + fmt(b.time);
  $('winNewBest').textContent = isNew ? '◆ NEW RECORD ◆' : '';
  $('btnNext').style.display = (levelIndex + 1 < LEVELS.length) ? 'block' : 'none';

  setTimeout(() => { if (state === 'win') showScreen('win'); }, 900);
  hintEl.classList.remove('on');
}

function nextLevel(){
  if (levelIndex + 1 < LEVELS.length) startLevel(levelIndex + 1);
  else showComplete();
}

function showComplete(){
  state = 'complete';
  let total = 0, all = true;
  for (let i = 0; i < LEVELS.length; i++){
    const b = save.best['L' + i];
    if (b) total += b.time; else all = false;
  }
  $('compTotal').textContent = all
    ? 'TOTAL TIME ' + fmt(total)
    : 'GARDENS CLEARED ' + Object.keys(save.best).length + '/' + LEVELS.length;
  showScreen('complete');
}

/* =========================================================
   VINE UPDATE
   ========================================================= */
function updateVine(dt){
  if (!vine.alive){
    vine.dieT += dt;
    return;
  }

  const h = vine.head;

  // steer toward mouse
  const dx = mouse.x - h.x;
  const dy = mouse.y - h.y;
  const targetAngle = Math.atan2(dy, dx);
  const diff = angleDiff(h.angle, targetAngle);
  const maxTurn = MAX_TURN * dt;
  h.angle += Math.max(-maxTurn, Math.min(maxTurn, diff));

  // move forward
  h.x += Math.cos(h.angle) * HEAD_SPEED * dt;
  h.y += Math.sin(h.angle) * HEAD_SPEED * dt;

  // wind
  h.x += level.wind.x * dt;
  h.y += level.wind.y * dt;

  // keep inside bounds (soft clamp)
  const pad = 14;
  if (h.x < pad){ h.x = pad; h.angle = angleDiff(h.angle, 0) < 0 ? h.angle : h.angle; }
  if (h.x > W - pad) h.x = W - pad;
  if (h.y < pad) h.y = pad;
  if (h.y > H - pad) h.y = H - pad;

  // head becomes segment 0
  vine.segments[0].x = h.x;
  vine.segments[0].y = h.y;

  // follow-the-leader
  const active = Math.min(MAX_SEGMENTS, Math.max(2, Math.floor(vine.length / SEG_SPACING)));
  for (let i = 1; i < active; i++){
    const s = vine.segments[i];
    const prev = vine.segments[i - 1];
    const ddx = prev.x - s.x;
    const ddy = prev.y - s.y;
    const d = Math.hypot(ddx, ddy);
    if (d > SEG_SPACING){
      const move = (d - SEG_SPACING) / d;
      s.x += ddx * move;
      s.y += ddy * move;
    }
  }
  // pin inactive segments to the tail (so they're ready when reactivated)
  const tail = vine.segments[active - 1];
  for (let i = active; i < MAX_SEGMENTS; i++){
    vine.segments[i].x = tail.x;
    vine.segments[i].y = tail.y;
  }

  // vitality drain
  vine.length -= DRAIN_RATE * dt;
  if (vine.length <= 0){
    vine.length = 0;
    die();
    return;
  }

  // collisions
  checkCollisions();
}

function checkCollisions(){
  const h = vine.head;
  const hr = 8;

  // droplets
  for (const d of level.droplets){
    if (d.got) continue;
    if (Math.hypot(h.x - d.x, h.y - d.y) < d.r + hr){
      d.got = true;
      vine.length = Math.min(MAX_LENGTH, vine.length + DROPLET_VALUE);
      spawnBurst(d.x, d.y, 14, ['#4fc3f7','#81d4fa','#ffffff'], 200, 3);
      tone(740, 0.14, 'sine', 0.05, 1100);
    }
  }

  // thorns
  for (const t of level.thorns){
    if (Math.hypot(h.x - t.x, h.y - t.y) < t.r + hr){
      // push head out
      const a = Math.atan2(h.y - t.y, h.x - t.x);
      h.x = t.x + Math.cos(a) * (t.r + hr + 2);
      h.y = t.y + Math.sin(a) * (t.r + hr + 2);
      vine.length -= THORN_DAMAGE;
      shake = 14;
      spawnBurst(h.x, h.y, 20, ['#8b2c2c','#c62828','#6d2020'], 260, 3.5);
      tone(160, 0.22, 'sawtooth', 0.05, 90);
      if (vine.length <= 0){ vine.length = 0; die(); return; }
    }
  }

  // flower
  if (level.flower.bloom === 0){
    if (Math.hypot(h.x - level.flower.x, h.y - level.flower.y) < 34 + hr){
      winLevel();
    }
  }
}

/* =========================================================
   UPDATE
   ========================================================= */
function update(dt){
  tGlobal += dt;
  updateParticles(dt);
  shake *= Math.pow(0.0009, dt);

  if (hintTimer > 0){
    hintTimer -= dt;
    if (hintTimer <= 0) hintEl.classList.remove('on');
  }

  if (state === 'play'){
    elapsed += dt;
    updateVine(dt);
    $('hudTimer').textContent = elapsed.toFixed(2);

    const pct = Math.max(0, vine.length / MAX_LENGTH);
    $('hudLen').textContent = Math.round(pct * 100);
    lenFill.style.width = (pct * 100) + '%';
    if (pct > 0.5)      lenFill.style.background = 'linear-gradient(90deg,#7cb342,#4fc3f7)';
    else if (pct > 0.22) lenFill.style.background = 'linear-gradient(90deg,#c98a1f,#ffb300)';
    else                 lenFill.style.background = 'linear-gradient(90deg,#8b2c2c,#c62828)';
  }

  if (state === 'win'){
    if (level.flower.bloom > 0 && level.flower.bloom < 1){
      level.flower.bloom = Math.min(1, level.flower.bloom + dt * 1.4);
    }
  }
}

/* =========================================================
   RENDER
   ========================================================= */
function drawBackground(){
  // warm parchment
  const g = ctx.createRadialGradient(W * 0.42, H * 0.36, 80, W * 0.5, H * 0.5, W * 0.8);
  g.addColorStop(0, '#fdf7e6');
  g.addColorStop(0.55, '#f2e8cc');
  g.addColorStop(1, '#dccfa8');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, W, H);

  // speckles
  for (const s of grass){
    const tw = 0.6 + 0.4 * Math.sin(tGlobal * 1.4 + s.ph);
    ctx.globalAlpha = s.a * tw;
    ctx.fillStyle = `hsl(${s.hue},42%,38%)`;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;

  // soft organic grid
  ctx.strokeStyle = 'rgba(45,80,22,0.045)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let x = 0; x <= W; x += 90){ ctx.moveTo(x, 0); ctx.lineTo(x, H); }
  for (let y = 0; y <= H; y += 90){ ctx.moveTo(0, y); ctx.lineTo(W, y); }
  ctx.stroke();
}

function drawDroplet(d){
  const t = tGlobal;
  const bob = Math.sin(t * 2 + d.phase) * 3;
  const x = d.x, y = d.y + bob;
  const pulse = 0.85 + 0.15 * Math.sin(t * 3 + d.phase);

  // glow
  const g = ctx.createRadialGradient(x, y, 0, x, y, d.r * 3.4);
  g.addColorStop(0, 'rgba(79,195,247,0.45)');
  g.addColorStop(0.5, 'rgba(79,195,247,0.12)');
  g.addColorStop(1, 'rgba(79,195,247,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(x, y, d.r * 3.4 * pulse, 0, Math.PI * 2);
  ctx.fill();

  // water drop body
  ctx.save();
  ctx.shadowColor = 'rgba(79,195,247,0.7)';
  ctx.shadowBlur = 14;
  ctx.fillStyle = '#4fc3f7';
  ctx.beginPath();
  ctx.arc(x, y, d.r * pulse, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  // highlight
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.beginPath();
  ctx.arc(x - d.r * 0.32, y - d.r * 0.34, d.r * 0.28, 0, Math.PI * 2);
  ctx.fill();

  // tiny sparkle
  ctx.fillStyle = 'rgba(255,255,255,0.6)';
  ctx.beginPath();
  ctx.arc(x + d.r * 0.28, y + d.r * 0.22, d.r * 0.13, 0, Math.PI * 2);
  ctx.fill();
}

function drawThorn(t){
  const pulse = 0.9 + 0.1 * Math.sin(tGlobal * 2.2 + t.x * 0.01);

  // dark ground halo
  const g = ctx.createRadialGradient(t.x, t.y, t.r * 0.3, t.x, t.y, t.r * 1.7);
  g.addColorStop(0, 'rgba(139,44,44,0.28)');
  g.addColorStop(1, 'rgba(139,44,44,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(t.x, t.y, t.r * 1.7, 0, Math.PI * 2);
  ctx.fill();

  // base circle
  ctx.fillStyle = '#5d1f1f';
  ctx.beginPath();
  ctx.arc(t.x, t.y, t.r * 0.55, 0, Math.PI * 2);
  ctx.fill();

  // spikes
  const spikes = Math.max(6, Math.floor(t.r / 9));
  ctx.save();
  ctx.translate(t.x, t.y);
  ctx.rotate(tGlobal * 0.25);
  for (let i = 0; i < spikes; i++){
    const a = (i / spikes) * Math.PI * 2;
    ctx.save();
    ctx.rotate(a);
    ctx.beginPath();
    ctx.moveTo(t.r * 0.45, -4);
    ctx.lineTo(t.r * pulse, 0);
    ctx.lineTo(t.r * 0.45, 4);
    ctx.closePath();
    ctx.fillStyle = '#8b2c2c';
    ctx.fill();
    ctx.strokeStyle = '#4a1414';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.restore();
  }
  ctx.restore();

  // core
  ctx.fillStyle = '#c62828';
  ctx.beginPath();
  ctx.arc(t.x, t.y, t.r * 0.18, 0, Math.PI * 2);
  ctx.fill();
}

function drawFlower(){
  const f = level.flower;
  const t = tGlobal;
  const bloom = (state === 'win') ? level.flower.bloom : 0;
  const baseScale = 1 + bloom * 0.6;
  const pulse = 0.95 + 0.05 * Math.sin(t * 2.4);

  // glow aura
  const auraR = 80 * baseScale * (1 + bloom * 0.8);
  const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, auraR);
  g.addColorStop(0, `rgba(255,179,0,${0.35 + bloom * 0.35})`);
  g.addColorStop(0.5, `rgba(255,209,102,${0.12 + bloom * 0.15})`);
  g.addColorStop(1, 'rgba(255,179,0,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(f.x, f.y, auraR, 0, Math.PI * 2);
  ctx.fill();

  // petals
  const petals = 8;
  ctx.save();
  ctx.translate(f.x, f.y);
  ctx.rotate(t * 0.3);
  const petalR = 32 * baseScale * pulse;
  for (let i = 0; i < petals; i++){
    const a = (i / petals) * Math.PI * 2;
    ctx.save();
    ctx.rotate(a);
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.bezierCurveTo(petalR * 0.5, -petalR * 0.35, petalR * 1.0, -petalR * 0.15, petalR * 1.2, 0);
    ctx.bezierCurveTo(petalR * 1.0, petalR * 0.15, petalR * 0.5, petalR * 0.35, 0, 0);
    ctx.closePath();
    const pg = ctx.createLinearGradient(0, 0, petalR * 1.2, 0);
    pg.addColorStop(0, '#ffd166');
    pg.addColorStop(1, '#ffb300');
    ctx.fillStyle = pg;
    ctx.shadowColor = 'rgba(255,179,0,0.7)';
    ctx.shadowBlur = 12;
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
  }

  // inner ring
  ctx.beginPath();
  ctx.arc(0, 0, petalR * 0.55, 0, Math.PI * 2);
  ctx.fillStyle = '#ff6f00';
  ctx.fill();
  ctx.beginPath();
  ctx.arc(0, 0, petalR * 0.28, 0, Math.PI * 2);
  ctx.fillStyle = '#fff3c4';
  ctx.fill();
  ctx.restore();

  // little guiding arrow when not yet bloomed
  if (state === 'play'){
    const dx = f.x - vine.head.x;
    const dy = f.y - vine.head.y;
    const dist = Math.hypot(dx, dy);
    if (dist > 260){
      const a = Math.atan2(dy, dx);
      const ax = f.x - Math.cos(a) * 90;
      const ay = f.y - Math.sin(a) * 90;
      ctx.save();
      ctx.translate(ax, ay);
      ctx.rotate(a);
      ctx.globalAlpha = 0.35 + 0.15 * Math.sin(t * 4);
      ctx.beginPath();
      ctx.moveTo(10, 0);
      ctx.lineTo(-8, -7);
      ctx.lineTo(-8, 7);
      ctx.closePath();
      ctx.fillStyle = '#c98a1f';
      ctx.fill();
      ctx.restore();
      ctx.globalAlpha = 1;
    }
  }
}

function drawVine(){
  const active = Math.min(MAX_SEGMENTS, Math.max(2, Math.floor(vine.length / SEG_SPACING)));
  const segs = vine.segments;

  // fade factor during death animation
  let alpha = 1;
  if (!vine.alive){
    alpha = Math.max(0, 1 - vine.dieT * 1.1);
  }
  if (alpha <= 0) return;

  // soft shadow underneath
  ctx.save();
  ctx.globalAlpha = 0.18 * alpha;
  ctx.fillStyle = '#3e2a12';
  ctx.beginPath();
  for (let i = 0; i < active; i += 2){
    const t = i / (active - 1);
    const r = 2.5 + (1 - t) * 5.5;
    const s = segs[i];
    ctx.moveTo(s.x + 2, s.y + 3);
    ctx.arc(s.x + 2, s.y + 3, r, 0, Math.PI * 2);
  }
  ctx.fill();
  ctx.restore();

  // main body — draw tail to head so head sits on top
  ctx.save();
  ctx.globalAlpha = alpha;
  for (let i = active - 1; i >= 0; i--){
    const t = i / (active - 1);      // 0 = head, 1 = tail
    const r = 2.4 + t * 5.6;         // thin at head, thick at tail
    const s = segs[i];

    // gradient from deep green (base) to bright green (tip)
    const mix = 1 - t;
    const cr = Math.round(45  + (139 - 45)  * mix);
    const cg = Math.round(80  + (195 - 80)  * mix);
    const cb = Math.round(22  + (60  - 22)  * mix);
    ctx.fillStyle = `rgb(${cr},${cg},${cb})`;
    ctx.beginPath();
    ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  // bright highlight stripe along the top
  ctx.globalAlpha = 0.35 * alpha;
  ctx.fillStyle = '#d4edac';
  for (let i = 0; i < active - 1; i += 2){
    const t = i / (active - 1);
    const r = 1.0 + t * 1.8;
    const s = segs[i];
    ctx.beginPath();
    ctx.arc(s.x - 1.5, s.y - 1.5, r, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = alpha;

  // leaves
  for (let i = 14; i < active - 6; i += 16){
    const s = segs[i];
    const a = segs[i - 1];
    const dir = Math.atan2(s.y - a.y, s.x - a.x);
    const side = ((i / 16) | 0) % 2 === 0 ? 1 : -1;
    const perp = dir + Math.PI / 2 * side;
    const t = i / (active - 1);

    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(perp);
    const wig = Math.sin(tGlobal * 2 + i) * 0.15;
    ctx.rotate(wig);
    ctx.globalAlpha = alpha * (0.85 - t * 0.2);
    const leafLen = 12 + (1 - t) * 6;
    ctx.beginPath();
    ctx.ellipse(leafLen * 0.5, 0, leafLen * 0.55, leafLen * 0.28, 0, 0, Math.PI * 2);
    const lg = ctx.createLinearGradient(0, 0, leafLen, 0);
    lg.addColorStop(0, '#7cb342');
    lg.addColorStop(1, '#8bc34a');
    ctx.fillStyle = lg;
    ctx.fill();
    ctx.strokeStyle = 'rgba(45,80,22,0.4)';
    ctx.lineWidth = 0.7;
    ctx.stroke();
    ctx.restore();
  }
  ctx.globalAlpha = 1;

  // head bud
  if (vine.alive){
    const h = segs[0];
    const t = tGlobal;
    const lowVital = vine.length < MAX_LENGTH * 0.22;
    const pulse = 1 + Math.sin(t * 5) * (lowVital ? 0.14 : 0.06);

    // soft halo
    const hg = ctx.createRadialGradient(h.x, h.y, 0, h.x, h.y, 30 * pulse);
    hg.addColorStop(0, lowVital ? 'rgba(198,40,40,0.5)' : 'rgba(139,195,74,0.45)');
    hg.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = hg;
    ctx.beginPath();
    ctx.arc(h.x, h.y, 30 * pulse, 0, Math.PI * 2);
    ctx.fill();

    // bud body
    ctx.save();
    ctx.shadowColor = lowVital ? '#c62828' : '#8bc34a';
    ctx.shadowBlur = 18;
    ctx.fillStyle = lowVital ? '#e57373' : '#c5e1a5';
    ctx.beginPath();
    ctx.arc(h.x, h.y, 8 * pulse, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    // eye-like center
    ctx.fillStyle = lowVital ? '#8b2c2c' : '#558b2f';
    ctx.beginPath();
    ctx.arc(h.x, h.y, 3.5, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.restore();
}

function drawParticles(){
  for (const q of parts){
    const a = Math.max(0, q.life / q.max);
    ctx.save();
    ctx.globalAlpha = a;
    ctx.translate(q.x, q.y);
    ctx.rotate(q.rot);
    ctx.fillStyle = q.color;
    ctx.beginPath();
    ctx.ellipse(0, 0, q.size * a, q.size * 0.55 * a, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha = 1;
}

function drawCursor(){
  if (state !== 'play') return;
  const t = tGlobal;
  const pulse = 0.9 + 0.1 * Math.sin(t * 4);

  const g = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 34 * pulse);
  g.addColorStop(0, 'rgba(255,241,180,0.55)');
  g.addColorStop(0.45, 'rgba(255,209,102,0.14)');
  g.addColorStop(1, 'rgba(255,209,102,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(mouse.x, mouse.y, 34 * pulse, 0, Math.PI * 2);
  ctx.fill();

  ctx.strokeStyle = 'rgba(201,138,31,0.55)';
  ctx.lineWidth = 1.4;
  ctx.setLineDash([3, 5]);
  ctx.beginPath();
  ctx.arc(mouse.x, mouse.y, 12 * pulse, 0, Math.PI * 2);
  ctx.stroke();
  ctx.setLineDash([]);

  ctx.fillStyle = '#fff3c4';
  ctx.beginPath();
  ctx.arc(mouse.x, mouse.y, 3.5, 0, Math.PI * 2);
  ctx.fill();
}

function render(){
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.fillStyle = '#1a1408';
  ctx.fillRect(0, 0, cv.width, cv.height);

  const sx = (Math.random() - 0.5) * shake * view.scale;
  const sy = (Math.random() - 0.5) * shake * view.scale;

  ctx.setTransform(view.scale, 0, 0, view.scale, view.ox + sx, view.oy + sy);
  ctx.save();
  ctx.beginPath();
  ctx.rect(0, 0, W, H);
  ctx.clip();

  drawBackground();

  if (level){
    // thorns first (under vine)
    for (const t of level.thorns) drawThorn(t);

    // droplets
    for (const d of level.droplets) if (!d.got) drawDroplet(d);

    // flower
    drawFlower();

    // vine
    if (vine) drawVine();

    drawParticles();

    // wind indicator
    if (level.wind.x !== 0 || level.wind.y !== 0){
      drawWindIndicator();
    }
  }

  drawCursor();

  // warm vignette
  const vg = ctx.createRadialGradient(W/2, H/2, H*0.42, W/2, H/2, H*1.0);
  vg.addColorStop(0, 'rgba(0,0,0,0)');
  vg.addColorStop(1, 'rgba(70,40,10,0.45)');
  ctx.fillStyle = vg;
  ctx.fillRect(0, 0, W, H);

  ctx.restore();
}

function drawWindIndicator(){
  const t = tGlobal;
  const dir = Math.atan2(level.wind.y, level.wind.x);
  const mag = Math.hypot(level.wind.x, level.wind.y);
  const count = 7;
  ctx.save();
  ctx.globalAlpha = 0.28;
  ctx.strokeStyle = '#8b6f4a';
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  for (let i = 0; i < count; i++){
    const seed = i * 97.3;
    const baseX = (seed * 13) % W;
    const baseY = (seed * 29 + t * (60 + mag) * 0.6) % H;
    const len = 40 + (i % 3) * 20;
    ctx.beginPath();
    ctx.moveTo(baseX, baseY);
    ctx.lineTo(baseX + Math.cos(dir) * len, baseY + Math.sin(dir) * len);
    ctx.stroke();
  }
  ctx.restore();
}

/* =========================================================
   MAIN LOOP
   ========================================================= */
let last = performance.now();
function loop(now){
  let dt = (now - last) / 1000;
  last = now;
  if (dt > 0.05) dt = 0.05;
  if (dt < 0) dt = 0;

  update(dt);
  render();
  requestAnimationFrame(loop);
}

/* =========================================================
   MENUS
   ========================================================= */
function buildLevelGrid(){
  const grid = $('levelGrid');
  grid.innerHTML = '';
  LEVELS.forEach((L, i) => {
    const locked = (i + 1) > save.unlocked;
    const b = save.best['L' + i];
    const el = document.createElement('div');
    el.className = 'lv' + (locked ? ' locked' : '');
    const st = b ? starsFor(b.time, L.par) : 0;
    el.innerHTML =
      '<div class="n">' + String(i + 1).padStart(2, '0') + '</div>' +
      '<div class="s">' + (locked ? '🔒' : (st ? '★'.repeat(st) + '☆'.repeat(3 - st) : '☆☆☆')) + '</div>' +
      '<div class="t">' + (locked ? 'LOCKED' : (b ? fmt(b.time) : L.name)) + '</div>';
    if (!locked) el.addEventListener('click', () => { audio(); startLevel(i); });
    grid.appendChild(el);
  });
}

$('btnPlay').addEventListener('click', () => {
  audio();
  const startIdx = Math.min(save.unlocked - 1, LEVELS.length - 1);
  startLevel(startIdx);
});
$('btnLevels').addEventListener('click', () => {
  audio();
  buildLevelGrid();
  state = 'levels';
  showScreen('levels');
});
$('btnBackMenu').addEventListener('click', () => { state = 'menu'; showScreen('menu'); });
$('btnResume').addEventListener('click', resume);
$('btnRestartP').addEventListener('click', () => startLevel(levelIndex));
$('btnMenuP').addEventListener('click', () => { state = 'menu'; showScreen('menu'); });
$('btnRetry').addEventListener('click', () => startLevel(levelIndex));
$('btnMenuD').addEventListener('click', () => { state = 'menu'; showScreen('menu'); });
$('btnNext').addEventListener('click', nextLevel);
$('btnReplay').addEventListener('click', () => startLevel(levelIndex));
$('btnMenuW').addEventListener('click', () => { state = 'menu'; showScreen('menu'); });
$('btnCompMenu').addEventListener('click', () => { state = 'menu'; showScreen('menu'); });

/* =========================================================
   BOOT
   ========================================================= */
loadSave();
resize();
showScreen('menu');
requestAnimationFrame(loop);

})();
</script>
